<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Acceso Privado</title>
  <style>
    body {
      margin: 0;
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #1a0014, #4d002f, #ff006e);
      background-size: 180% 180%;
      animation: glow 10s ease infinite;
      color: #fff;
      text-align: center;
      padding: 40px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 100vh;
    }
    @keyframes glow {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    h1 { font-size: 3em; margin-bottom: 5px; letter-spacing: 2px; font-weight: 700; }
    h2 { font-size: 1.5em; margin-bottom: 30px; opacity: 0.9; }
    p  { font-size: 1.3em; margin: 10px 0; opacity: 0.95; }
    img { max-width: 90%; margin-top: 25px; border-radius: 15px; box-shadow: 0 0 20px rgba(255, 0, 112, 0.6); animation: softPulse 3s infinite ease-in-out; }
    @keyframes softPulse { 0% { transform: scale(1); opacity:.95 } 50% { transform: scale(1.03); opacity:1 } 100% { transform: scale(1); opacity:.95 } }
    .btn {
      display:inline-block; padding:12px 16px; border-radius:12px; background:#fff; color:#1a0014;
      text-decoration:none; font-weight:600; border:1px solid rgba(255,255,255,.3); margin-top:14px;
    }
    .hidden { display:none; }
  </style>
</head>
<body>
  <div id="instructionsCard">
    <h1>PRIVATE ACCESS</h1>
    <h2>Follow these instructions to enter</h2>
    <p>1. Tap the three dots in the upper right corner.</p>
    <p>2. Select <b>"Open in browser"</b>.</p>
    <a id="continueBtn" class="btn" href="#">Continuar</a>
    <img src="/clook/gif/gitonly.png" alt="Instructions">
  </div>

  <script>
    // obtiene el :id si estamos en /instructions/:id
    function currentIdFromPath() {
      const m = (location.pathname || '').match(/^\/instructions\/([^\/?#]+)/i);
      return m ? decodeURIComponent(m[1]) : null;
    }
    // detector simple de móvil
    function isMobile() {
      const ua = (navigator.userAgent || '').toLowerCase();
      return /android|iphone|ipad|ipod|mobile/i.test(ua);
    }

    (function init(){
      const id = currentIdFromPath();
      const loadingPath = id ? `/loading/${id}` : '/loading';

      const go = () => {
        try { location.replace(loadingPath); } catch { location.href = loadingPath; }
      };

      // Desktop: NO mostrar instrucciones → ir directo a loading
      if (!isMobile()) return go();

      // Móvil: mostrar instrucciones y dejar botón para continuar a loading
      const btn = document.getElementById('continueBtn');
      if (btn) {
        btn.href = loadingPath;
        btn.addEventListener('click', function(ev){ ev.preventDefault(); go(); });
      }
    })();
  </script>
</body>
</html>
